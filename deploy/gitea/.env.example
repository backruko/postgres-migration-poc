# /srv/gitea/compose/.env の見本（Gitea とランナー。アプリの /srv/ops/.env とは別）
# 写して値を入れる: sudo cp .env.example .env && sudo vi .env && sudo chmod 600 .env

# サーバーの IP アドレス（またはホスト名）。社内の PC とジョブのコンテナの両方から届くもの（localhost は不可）
SERVER_ADDRESS=10.0.0.5

# 版（Docker Hub の gitea/gitea と gitea/act_runner のタグ）。上げるときは先に gitea dump を取る
GITEA_VERSION=1.24
ACT_RUNNER_VERSION=0.2.11

# ランナーの登録トークン（最初の 1 回だけ。リポジトリの 設定 → Actions → ランナー → 新しいランナーを作成）。
# 登録できたら消してかまわない
RUNNER_TOKEN=
