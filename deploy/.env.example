# deploy/.env の見本。コピーして値を決める:  cp .env.example .env
# .env は git に入れない（パスワードが入るため）。

# --- データベース ---
POSTGRES_DB=ops
POSTGRES_USER=ops
# 英字と数字だけにする（接続 URL に入るため。記号を使うなら URL エンコードが必要）
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- 画面のポート（http://<サーバー>:<ポート>/。80 なら http://<サーバー>/） ---
HTTP_PORT=80

# --- 毎日のバックアップ（pg_dump） ---
# 保存先（このフォルダーを OS 側で NAS へ同期する）
BACKUP_DIR=./backups
# 実行する時刻（日本時間）
BACKUP_TIME=01:00
# 何日分残すか（0 なら消さない）
BACKUP_KEEP_DAYS=14
