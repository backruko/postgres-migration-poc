# deploy/.env の見本。サーバーでは /srv/ops/.env に 1 つだけ置く（版を入れるたびに deploy/install.sh がつなぐ）:
#   cp .env.example /srv/ops/.env
# .env は git に入れない（パスワードが入るため）。

# --- データベース ---
POSTGRES_DB=ops
POSTGRES_USER=ops
# 英字と数字だけにする（接続 URL に入るため。記号を使うなら URL エンコードが必要）
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- 画面のポート（http://<サーバー>:<ポート>/。80 なら http://<サーバー>/） ---
HTTP_PORT=80

# --- 版の外に置くもの（版のフォルダーを入れ替えても残る） ---
# 毎日のバックアップの保存先（このフォルダーを OS 側で NAS へ同期する）
BACKUP_DIR=/srv/ops/backups
# API のログ（app.log。10 MB × 5 で回る）
LOG_DIR=/srv/ops/logs

# --- 毎日のバックアップ（pg_dump） ---
# 実行する時刻（日本時間）
BACKUP_TIME=01:00
# 何日分残すか（0 なら消さない）
BACKUP_KEEP_DAYS=14

# --- 通知のメール（SMTP。worker が送る） ---
# 送り先のメールサーバー。空なら送らない（配信は再試行の後に「失敗」として見える）
SMTP_HOST=
# 既定 587。社内の中継サーバーなら 25 のことが多い
SMTP_PORT=
# ログインが要るときだけ
SMTP_USER=
SMTP_PASSWORD=
# 差出人（既定 system-noreply@example.com）
SMTP_FROM_ADDRESS=
# 空 = サーバーが対応していれば STARTTLS を使う。1 = 必ず使う。0 = 使わない
SMTP_STARTTLS=
# 通知の本文に入れる画面へのリンクの先頭（例: http://10.0.0.5）。サーバーのアドレスが決まったら入れる
APP_BASE_URL=

# --- 会社のプロキシ（ふつうは空のまま。2026-11-17: たぶん要らないと分かった） ---
# 空 = 直接インターネットに出る。プロキシが要るときだけ、イメージを作るときの apt / pip / npm に使う
# （README の「付録. プロキシが必要なとき」の 5.）。例: HTTP_PROXY=http://proxy.example.co.jp:8080
# 利用者名とパスワードが要るときは http://user:pass@proxy:8080（記号は URL エンコード）
# docker pull（元になるイメージの取得）は別の設定です: 同じ付録の 3.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
