# deploy/.env の見本。サーバーでは /srv/ops/.env に 1 つだけ置く（版を入れるたびに deploy/install.sh がつなぐ）:
#   cp .env.example /srv/ops/.env
# .env は git に入れない（パスワードが入るため）。

# --- データベース ---
POSTGRES_DB=ops
POSTGRES_USER=ops
# 英字と数字だけにする（接続 URL に入るため。記号を使うなら URL エンコードが必要）
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- 画面のポート（http://<サーバー>:<ポート>/。80 なら http://<サーバー>/） ---
HTTP_PORT=80

# --- 版の外に置くもの（版のフォルダーを入れ替えても残る） ---
# 毎日のバックアップの保存先（このフォルダーを OS 側で NAS へ同期する）
BACKUP_DIR=/srv/ops/backups
# API のログ（app.log。10 MB × 5 で回る）
LOG_DIR=/srv/ops/logs

# --- 毎日のバックアップ（pg_dump） ---
# 実行する時刻（日本時間）
BACKUP_TIME=01:00
# 何日分残すか（0 なら消さない）
BACKUP_KEEP_DAYS=14

# --- 会社のプロキシ（イメージを作るときだけ使う。apt / pip / npm がこれを通る） ---
# 直接インターネットに出られるなら空のまま。例: HTTP_PROXY=http://proxy.example.co.jp:8080
# 利用者名とパスワードが要るときは http://user:pass@proxy:8080（記号は URL エンコード）
# docker pull（元になるイメージの取得）は別の設定です: README の「0. サーバーの準備」
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
