{
  "name": "plan-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/shared/api/schema.gen.ts",
    "gen:api:live": "openapi-typescript http://127.0.0.1:8000/openapi.json -o ./src/shared/api/schema.gen.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.2",
    "antd": "5.22.5",
    "dayjs": "1.11.13",
    "openapi-fetch": "0.13.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
