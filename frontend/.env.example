# 開発時: Vite のプロキシ転送先（FastAPI の起動アドレス）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 本番ビルド時: API のベースURL（未指定なら同一オリジンの /api を使用）
# 別オリジンに置く場合は、バックエンドの .env に CORS_ORIGINS=["https://<このフロントのオリジン>"] も設定する
# VITE_API_BASE_URL=https://api.example.com

# 画面を開いたときの既定値（URLの ?client= / ?holidays= が優先）
VITE_DEFAULT_CLIENT=MOCK
VITE_DEFAULT_HOLIDAY_CALENDAR=JP_BANK
VITE_TIMEZONE=Asia/Tokyo

# 操作する職員の既定の ID（ログインが入るまでの開発用。ナビの「操作する職員」で選んだ ID が優先）
# VITE_DEFAULT_STAFF_ID=1
