# npm の決まり（このフォルダーの npm install / npm ci / CI / web のイメージのビルドで効く）
#
# 新しいパッケージを入れるとき、package.json に ^ や ~ を付けず正確な版で書く。
# ゆるい版だと、次の npm install で知らないうちに別の版が入りうる（今の依存はすべて正確な版）
save-exact=true
# インストールのときにパッケージのスクリプト（postinstall など）を動かさない。
# 乗っ取られたパッケージがインストールの時点でコードを動かす、いちばんよくある手口を止める。
# 今の依存にインストールのスクリプトは無い。いつか要るパッケージが入ったら、そのときに決める
ignore-scripts=true
# package.json の engines（Node の版）に合わないと、インストールを止める。
# 画面のビルドは CI と web のイメージで Node 24。違う版でできたものが紛れ込まないように
engine-strict=true
